{
    "name": "branch-compare-decorations",
    "displayName": "Branch Compare Decorations",
    "description": "Choose which branch Git file decorations in the Explorer compare against.",
    "version": "1.0.1",
    "publisher": "Florian-Noever",
    "license": "MIT",
    "icon": "assets/icon.png",
    "repository": {
        "type": "git",
        "url": "https://github.com/Florian-Noever/branch-compare-decorations"
    },
    "bugs": {
        "url": "https://github.com/Florian-Noever/branch-compare-decorations/issues"
    },
    "homepage": "https://github.com/Florian-Noever/branch-compare-decorations",
    "markdown": "github",
    "qna": "https://github.com/Florian-Noever/branch-compare-decorations/issues",
    "keywords": [
        "git",
        "compare",
        "branch",
        "base branch",
        "decorations",
        "diff"
    ],
    "engines": {
        "vscode": "^1.105.0"
    },
    "categories": [
        "SCM Providers",
        "Other"
    ],
    "extensionKind": [
        "workspace"
    ],
    "extensionDependencies": [
        "vscode.git"
    ],
    "activationEvents": [
        "workspaceContains:.git",
        "onStartupFinished"
    ],
    "main": "./out/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "branchCompareDecorations.setBase",
                "title": "Set Base Branch",
                "category": "Branch Compare Decorations"
            },
            {
                "command": "branchCompareDecorations.refresh",
                "title": "Refresh Decorations",
                "category": "Branch Compare Decorations"
            },
            {
                "command": "branchCompareDecorations.deactivate",
                "title": "Deactivate",
                "category": "Branch Compare Decorations"
            },
            {
                "command": "branchCompareDecorations.activate",
                "title": "Activate",
                "category": "Branch Compare Decorations"
            }
        ],
        "menus": {
            "commandPalette": [
                {
                    "command": "branchCompareDecorations.setBase",
                    "when": "gitOpenRepositoryCount > 0 && config.branchCompareDecorations.enabled"
                },
                {
                    "command": "branchCompareDecorations.refresh",
                    "when": "gitOpenRepositoryCount > 0 && config.branchCompareDecorations.enabled"
                },
                {
                    "command": "branchCompareDecorations.deactivate",
                    "when": "gitOpenRepositoryCount > 0 && config.branchCompareDecorations.enabled"
                },
                {
                    "command": "branchCompareDecorations.activate",
                    "when": "gitOpenRepositoryCount > 0 && !config.branchCompareDecorations.enabled"
                }
            ]
        },
        "configuration": {
            "title": "Branch Compare Decorations",
            "properties": {
                "branchCompareDecorations.enabled": {
                    "type": "boolean",
                    "default": true,
                    "markdownDescription": "Show the decorations of this extension in the Explorer. Turn off to see only VS Code's built-in Git decorations. Toggled by **Branch Compare Decorations: Deactivate** and **Branch Compare Decorations: Activate**."
                },
                "branchCompareDecorations.baseRefs": {
                    "type": "object",
                    "default": {},
                    "markdownDescription": "Base branch or ref to compare each local branch against, keyed by branch name (e.g. `\"feature/login\": \"origin/main\"`). Use `__branch_origin__` for all changes since the branch was created, or `__main_origin__` for all changes since branching from the main development branch. Easiest to set with **Branch Compare Decorations: Set Base Branch**.",
                    "additionalProperties": {
                        "type": "string",
                        "description": "Base branch or ref to compare against. An empty string disables decorations for this branch."
                    },
                    "propertyNames": {
                        "pattern": "^[\\w./-]+$",
                        "description": "Branch name (allowed: letters, digits, _, ., /, -)"
                    }
                },
                "branchCompareDecorations.autoFetch": {
                    "type": "boolean",
                    "default": true,
                    "description": "Fetch the remote base ref (at most every 30 seconds) before computing changes."
                }
            }
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "npm run check-types && npm run lint && node esbuild.mjs",
        "watch": "node ./node_modules/npm-run-all/bin/npm-run-all/index.js -p watch:*",
        "watch:esbuild": "node esbuild.mjs --watch",
        "watch:tsc": "node ./node_modules/typescript/bin/tsc --noEmit --watch --project tsconfig.json",
        "package": "node ./node_modules/@vscode/vsce/vsce package --no-dependencies",
        "compile-tests": "node esbuild.mjs --tests",
        "pretest": "npm run check-types && npm run compile-tests",
        "check-types": "node ./node_modules/typescript/bin/tsc --noEmit",
        "lint": "node ./node_modules/eslint/bin/eslint.js src",
        "test": "node ./out/test/runTests.js"
    },
    "devDependencies": {
        "@types/mocha": "^10.0.10",
        "@types/node": "26.x",
        "@types/vscode": "~1.105.0",
        "@typescript-eslint/eslint-plugin": "^8.71.1",
        "@typescript-eslint/parser": "^8.71.1",
        "@vscode/test-electron": "^3.1.0",
        "@vscode/vsce": "^4.0.0",
        "esbuild": "^0.28.2",
        "eslint": "^10.12.0",
        "mocha": "^12.0.3",
        "npm-run-all": "^4.1.5",
        "typescript": "~6.0.3"
    },
    "dependencies": {
        "async-sema": "^3.1.1"
    }
}
