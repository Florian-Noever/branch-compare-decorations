{
  "name": "branch-compare",
  "displayName": "Branch Compare",
  "description": "Select to which branch git compares to display its colordecorations.",
  "version": "0.0.1",
  "publisher": "der-floh",
  "license": "MIT",
  "icon": "assets/icon-x512.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/FlorianNoeverGOB/branch-compare"
  },
  "bugs": {
    "url": "https://github.com/FlorianNoeverGOB/branch-compare/issues"
  },
  "homepage": "https://github.com/FlorianNoeverGOB/branch-compare",
  "keywords": [
    "git",
    "compare",
    "branch",
    "base branch",
    "decorations",
    "diff"
  ],
  "engines": {
    "vscode": "^1.103.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "extensionKind": [
    "workspace"
  ],
  "extensionDependencies": [
    "vscode.git"
  ],
  "activationEvents": [
    "workspaceContains:.git",
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "branchCompare.setBase",
        "title": "Branch Compare: Set Base Branch"
      },
      {
        "command": "branchCompare.refresh",
        "title": "Branch Compare: Refresh Decorations"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "branchCompare.setBase",
          "when": "gitOpenRepositoryCount > 0"
        },
        {
          "command": "branchCompare.refresh",
          "when": "gitOpenRepositoryCount > 0"
        }
      ]
    },
    "configuration": {
      "title": "Branch Compare",
      "properties": {
        "branchCompare.baseRefs": {
          "type": "object",
          "default": {},
          "markdownDescription": "List of the Branch and Base branch/ref to compare against (e.g. `yourBranch:` `origin/main`).",
          "additionalProperties": {
            "type": "string",
            "description": "Your Branch that should be compared."
          },
          "propertyNames": {
            "pattern": "^[\\w./-]+$",
            "description": "Branch name (allowed: letters, digits, _, ., /, -)"
          }
        },
        "branchCompare.autoFetch": {
          "type": "boolean",
          "default": true,
          "description": "Auto 'git fetch' the base ref before computing changes."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "package": "npx -y @vscode/vsce package"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.103.0",
    "@typescript-eslint/eslint-plugin": "^8.39.0",
    "@typescript-eslint/parser": "^8.39.0",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.32.0",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "async-sema": "^3.1.1"
  }
}